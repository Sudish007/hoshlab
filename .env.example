# Hoshlab local environment. Copy to .env (gitignored) and fill in what you have.
# Run the engine locally with:  node --env-file=.env engine/index.js daily --dry-run
# In GitHub Actions the same names are repository secrets / workflow env; .env is never read there.

# Anthropic API key (provider "anthropic" in company/config.json; shape ^\S{20,}$)
ANTHROPIC_API_KEY=
# Google Gemini API key (provider "gemini")
GEMINI_API_KEY=
# OpenAI API key (provider "openai")
OPENAI_API_KEY=

# Instagram long-lived access token for @rishtapatra (shape ^\S{50,}$; never printed or committed)
IG_TOKEN_RISHTAPATRA=
# Instagram long-lived access token for @kaatdo
IG_TOKEN_KAATDO=
# Instagram long-lived access token for @job_rez
IG_TOKEN_JOB_REZ=

# Set to 1 to answer every LLM call from tests/fixtures/llm instead of a provider (no keys needed, costUsd 0, usage rows mock:true)
MOCK_LLM=
# Optional fixture case for the mock adapter (tests/fixtures/llm/<agent>.<case>.json, e.g. bad, fail); empty = the default "ok" fixture.
# A per-agent override wins: MOCK_LLM_CASE_<AGENT> with the upper-case roster name, e.g. MOCK_LLM_CASE_WRITER=bad
MOCK_LLM_CASE=
# Set to 1 to use the dry-run Instagram client (logs the exact call sequence, publishes nothing)
IG_DRY_RUN=
# Set to 1 to run the Playwright render smoke tests (needs Chromium; reels also need ffmpeg/ffprobe)
RENDER_TESTS=

# Company directory to read/write (default company/; tests use tests/fixtures/company-populated)
COMPANY_DIR=
# Media worktree of the orphan `media` branch (default .media/; tests use tests/fixtures/media)
MEDIA_DIR=
# Build output directory (default dist/)
DIST_DIR=
# Where scripts/audit*.mjs write audit-results.json / audit-admin-results.json and viewport PNGs
# (default .agents/audit/; CI uses audit-out/ and uploads it as an artifact)
AUDIT_OUT=
# Audit a running or live site at this origin + basePath instead of serving dist/ (e.g. https://sudish007.github.io)
AUDIT_URL=
# Port for scripts/serve.mjs (default 4173)
PORT=

# Test-only knobs (scripts/test.mjs sets them; NEVER set them in CI or for the real build):
# BUILD_NOW pins the site build's clock to an ISO instant so dist tests are date-independent;
# PUBLIC_DIR points src/build.js at an alternative public/ folder.
BUILD_NOW=
PUBLIC_DIR=

# Set by GitHub Actions, not by you: CI=true makes `daily` and `publish` commit + push as hoshlab-bot
# (locally pass --commit instead); GITHUB_OUTPUT receives changed=true|false for the deploy job.
# Path to ffmpeg when it is not on PATH (reel rendering, Phase 2)
FFMPEG_PATH=
# Path to ffprobe when it is not on PATH (reel probing, Phase 2)
FFPROBE_PATH=
