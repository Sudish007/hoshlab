{
  "version": 1,
  "company": {
    "name": "Hoshlab",
    "nameDevanagari": "होशलैब",
    "owner": "Sudish Kumar",
    "ownerGithub": "Sudish007",
    "timezone": "Asia/Kolkata"
  },
  "site": {
    "url": "https://sudish007.github.io/hoshlab",
    "basePath": "/hoshlab/"
  },
  "repo": {
    "owner": "Sudish007",
    "name": "hoshlab",
    "branch": "main",
    "mediaBranch": "media"
  },
  "schedule": {
    "engineCron": "23 0 * * *",
    "engineLabel": "Daily 05:53 IST",
    "publisherCron": "17 * * * *",
    "publisherLabel": "Hourly at :47 IST",
    "tokenRefreshCron": "13 2 * * 1",
    "tokenRefreshLabel": "Mondays 07:43 IST",
    "actionsDelayNote": "GitHub may delay or skip scheduled runs; a due slot posts at the next run that fires"
  },
  "budget": {
    "monthlyUsd": 25,
    "warnAtPct": 80,
    "hardStop": true
  },
  "features": {
    "reels": true
  },
  "providers": {
    "anthropic": {
      "enabled": true,
      "tier": "paid",
      "minIntervalMs": 0,
      "secret": "ANTHROPIC_API_KEY",
      "endpoint": "https://api.anthropic.com/v1/messages",
      "apiVersion": "2023-06-01",
      "models": {
        "claude-sonnet-5-5": {
          "inputPerMTok": 2.0,
          "outputPerMTok": 10.0,
          "maxOutputTokens": 128000,
          "acceptsTemperature": false
        }
      },
      "priceSource": "https://platform.claude.com/docs/en/docs/about-claude/pricing",
      "pricesVerifiedAt": "2026-10-10",
      "priceNote": "Claude Sonnet 5.5, base tokens $2 / $10 per MTok, max output 128K (model page platform.claude.com/docs/en/models/sonnet-5-5/overview). The model page states that a non-default temperature, top_p or top_k returns a 400 error and that adaptive thinking is on by default."
    },
    "gemini": {
      "enabled": true,
      "tier": "free",
      "tierSource": "https://ai.google.dev/gemini-api/docs/pricing",
      "tierVerifiedAt": "2026-10-12",
      "tierNote": "Free input and output tokens; no card required in Google AI Studio. On the free tier, Content used to improve our products.",
      "minIntervalMs": 7000,
      "secret": "GEMINI_API_KEY",
      "endpoint": "https://generativelanguage.googleapis.com/v1beta",
      "models": {
        "gemini-3.8-flash": {
          "inputPerMTok": 0.75,
          "outputPerMTok": 3.75,
          "maxOutputTokens": 65536,
          "reasoning": "low"
        }
      },
      "priceSource": "https://ai.google.dev/gemini-api/docs/pricing",
      "pricesVerifiedAt": "2026-10-12",
      "modelSource": "https://ai.google.dev/gemini-api/docs/models",
      "modelsVerifiedAt": "2026-10-12",
      "priceNote": "Gemini 3.8 Flash is the current stable Flash model and has free input/output tokens on the free tier. Paid-equivalent rates are $0.75 / $3.75 per MTok through 2026-12-31 and $1.50 / $7.50 from 2027-01-01; output includes thinking tokens. The model page lists a 65,536 output-token limit; thinkingLevel low is its lowest accepted level. Re-run check-models in January 2027."
    },
    "openai": {
      "enabled": true,
      "tier": "paid",
      "minIntervalMs": 0,
      "secret": "OPENAI_API_KEY",
      "endpoint": "https://api.openai.com/v1/chat/completions",
      "models": {
        "gpt-6-luna": {
          "inputPerMTok": 0.1,
          "outputPerMTok": 0.5,
          "maxOutputTokens": 128000,
          "reasoning": "low"
        }
      },
      "priceSource": "https://developers.openai.com/api/docs/pricing",
      "pricesVerifiedAt": "2026-10-10",
      "priceNote": "GPT-6 Luna, standard short-context price ($0.10 / $0.50 per MTok; prompts over 272K input tokens cost 2x input and 1.5x output), max output 128,000 (model page developers.openai.com/api/docs/models/gpt-6-luna). Reasoning tokens bill as output."
    }
  },
  "defaults": {
    "leadDays": 3,
    "backlogWeeks": 2,
    "maxReworkLoops": 2,
    "maxPublishAttempts": 3,
    "minGapHours": 6,
    "lateAfterHours": 6,
    "expireAfterHours": 48,
    "hashtagCap": 8,
    "captionMax": 2200,
    "altTextMax": 100,
    "reel": { "minSec": 15, "maxSec": 30, "kineticScenes": [3, 6], "captureScenes": [3, 6] }
  },
  "ig": {
    "host": "https://graph.instagram.com",
    "version": "v26.0",
    "versionSource": "https://developers.facebook.com/docs/graph-api/changelog",
    "versionVerifiedAt": "2026-10-10",
    "pollIntervalMs": 5000,
    "pollMaxMs": 300000
  },
  "pages": [
    {
      "handle": "rishtapatra",
      "prefix": "rp",
      "displayName": "RishtaPatra · रिश्तापत्र",
      "brand": "company/brands/rishtapatra.md",
      "igUserId": "",
      "appScopedId": "",
      "tokenSecret": "IG_TOKEN_RISHTAPATRA",
      "mode": "approve_first",
      "modeChangedAt": "2026-10-10T19:00:00+05:30",
      "modeChangedBy": "owner",
      "languages": ["hi", "en"],
      "formats": ["image", "carousel", "reel"],
      "brandColor": "#7a1f2b",
      "cadence": {
        "slots": [
          { "dow": "mon", "time": "19:30", "format": "image" },
